#!/bin/sh
# W8 / T5 arm: w8_stream_m5op
# Injected at restore via m5 readfile. The guest's /sbin/init execs this.
echo "W8-RCS-START w8_stream_m5op"
/bin/mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
/sbin/m5 resetstats
/root/cxl_join_bench.gem5fs --mode morsel --policy stream --declare m5op \
  --fact-bytes 16777216 --hot-bytes 4194304 --reps 1 --warmups 0 \
  --probe-batch 0 --json
echo "W8-RCS-BENCH-EXIT $?"
/sbin/m5 dumpstats
echo "W8-RCS-DONE w8_stream_m5op"
/sbin/m5 exit
