# Experiment outputs / raw data — large, archived separately (see experiments/asplos/README.md).
# Not versioned: 30MB+ and grows per run. Preserve via a tarball / GitHub Release, not the code repo.
results/

# Backups & patch/editor cruft
*.orig
*~
.DS_Store

# Python caches
__pycache__/
*.pyc

# Local build/scratch
*.o
*.a

# Compiled bench binaries. The .c sources, lib/, and the Makefile are all tracked;
# `make -C benchmarks/bench` reproduces every binary from them. Whitelist the sources
# so a new aggressor/victim .c is never silently ignored along with its output.
benchmarks/bench/aggressor/*
!benchmarks/bench/aggressor/*.c
!benchmarks/bench/aggressor/*.h
benchmarks/bench/victim/*
!benchmarks/bench/victim/*.c
!benchmarks/bench/victim/*.h

# gem5 writes a default m5out/ when invoked without --outdir; pure detritus.
m5out/
